# Copy this file to .env and update the values for your computer.
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=railway_reservation_system
DB_USER=root
DB_PASSWORD=
DB_CONNECTION_LIMIT=10

# Replace this with a long random secret. Do not commit .env to Git.
JWT_SECRET=replace_this_with_a_long_random_secret_at_least_32_characters
COOKIE_NAME=rrs_session

# Academic demo rules only; these are NOT official Bangladesh Railway rules.
BOOKING_HOLD_MINUTES=10
CANCELLATION_CUTOFF_HOURS=6
DEMO_REFUND_PERCENT=80
